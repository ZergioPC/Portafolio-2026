---
import Layout from '@/layouts/Layout.astro'

import SocialMediaGallery from '@/components/custom/SocialMediaGallery.astro';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

import TitleSection from '@/components/custom/TitleSection.astro'
import VideoFaderGallery from '@/components/custom/VideoFaderGallery.astro';
import Hero from '@/components/Hero.astro';

import BubbleGraph from '@/components/custom/BubbleGraph.astro';

import DevMainProjects from '@/components/section_dev/MainProjectsContainer/index.astro'
import DevOtherProjects from '@/components/section_dev/OtherProjectsContainer/index.astro'

import MusicVideoPlayer from "@/components/section_music/MusicVideoPlayer/index.astro"
import Models3DContainer from "@/components/section_model3d/Models3DContainer/index.astro"
import BlogPostsContainer from "@/components/section_blog/BlogPostsContainer/index.astro"

import ContainerHover from '@/components/ContainerHover.astro';
import Container from '@/components/Container.astro';
import Division from '@/components/utils/Division.astro';
import FormalList from '@/components/FormalList.astro';
import IconsList from '@/components/IconsList.astro';
import SeeMore from '@/components/custom/SeeMore.astro';

interface BlogFrontmatter {
  titulo: string
  imagen: string
  fecha: string
}

interface BlogModule {
  url: string
  frontmatter: BlogFrontmatter
}

interface PostData {
  url: string
  titulo: string
  imagen: string
  fecha: string
}

const blogModules = import.meta.glob<BlogModule>('./blog/*.md', { eager: true });

const sortedPosts: PostData[] = Object.values(blogModules)
  .map((p: BlogModule) => ({
    url: p.url,
    titulo: p.frontmatter.titulo,
    imagen: p.frontmatter.imagen,
    fecha: p.frontmatter.fecha,
  }))
  .sort((a, b) => {
    const [aD, aM, aY] = a.fecha.split('/');
    const [bD, bM, bY] = b.fecha.split('/');
    return new Date(bY, bM - 1, bD) - new Date(aY, aM - 1, aD);
  })
  .slice(0, 3);
---

<Layout titulo='Sergio Palacios'>
  <Header />

  <Hero id="inicio" />

  <Division width_val={0} height_val={25} />
  <h2 style="text-align: center;">Proyectos en Redes</h2>
  <Division width_val={0} height_val={25} />

  <section class="section-class">
    <SocialMediaGallery />
  </section>

  <Division width_val={0} height_val={100} />
  <h2 style="text-align: center;">Skills</h2>
  <Division width_val={0} height_val={25} />

  <section class="section-class">
    <div 
      class="two-columns-grid-2"
      style="gap: 20px;"
    >
      <div>
        <h3>Comercial</h3>
        <Division width_val={0} height_val={10} />
        <FormalList 
          radius="15px"
          items={[
            "Adobe After Effects",
            "Adobe Illustrator",
            "Adobe Photoshop",
            "Adobe Premiere",
            "Adobe Substance",
            "Autodesk Maya 3D",
            "Unity Engine",
            "Microsoft Word",
            "Microsoft Powerpoint",
            "Microsoft Excel",
          ]}
        />
      </div>
      <div>
        <h3 style="text-align: right;">Open Source</h3>
        <Division width_val={0} height_val={10} />
        <IconsList
          border_radius={15}
          blur={5} 
          items={[
            { name: "Blender", url: "https://blender.org", image: "/third_part_logos/blender_icon_512x512.png" },
            { name: "GIMP", url: "https://gimp.org", image: "/third_part_logos/gimp.png" },
            { name: "Godot", url: "https://godotengine.org", image: "/third_part_logos/godot.svg" },
            { name: "Inkscape", url: "https://inkscape.org", image: "/third_part_logos/Inkscape_Logo.svg.png" },
            { name: "Krita", url: "https://krita.org", image: "/third_part_logos/krita.png" },
            { name: "Reaper", url: "https://reaper.fm", image: "/third_part_logos/reaper.png" },
            { name: "OBS Studio", url: "https://obsproject.com", image: "/third_part_logos/obs_studio.png" },
          ]}
        />
        <small class="legal-advice">
          <br>
          The icons and trademarks shown on this portfolio belong to their respective owners and are used solely for identification purposes. Their presence does not imply affiliation, endorsement, or sponsorship.
        </small>
      </div>
    </div>
  </section>

  <div id="programacion"></div>
  <Division width_val={0} height_val={100} />

  <section class="section-class">
    <ContainerHover 
      border_radius={15}
      padding_value={50}
    >
      <div class="two-columns-grid">
        <TitleSection
          titulo="Programación"
        >
          <p>Es una de mis principales habilidades, cuento con experiencia en el <strong>desarrollo de videojuegos</strong> y en la <strong>programación web.</strong> habiendo desarrollado proyectos desde el bocetado inicial hasta la entrega final, y de ser necesario, iteraciones para mejorar o agregar funcionalidades nuevas.</p>
        </TitleSection>
        <BubbleGraph
          items={[
            { image: "/third_part_logos/js.svg",  size: 90,  label: 'Javascript'},
            { image: "/third_part_logos/html.svg",  size: 60,  label: 'HTML'},
            { image: "/third_part_logos/css.svg",  size: 60,  label: 'CSS'},
            { image: "/third_part_logos/postgresql.png",  size: 30,  label: 'PostgreSQL'},
            { image: "/third_part_logos/fastapi.svg",  size: 40,  label: 'FastApi'},
            { image: "/third_part_logos/astro.png",  size: 30,  label: 'Astro'},
            { image: "/third_part_logos/python.svg",  size: 60,  label: 'Python'},
            { image: "/third_part_logos/react-logo.svg",  size: 50,  label: 'React'},
            { image: "/third_part_logos/tux-linux.svg",  size: 30,  label: 'Linux'},
            { image: "/third_part_logos/ts-logo-128.svg",  size: 20,  label: 'Typescript'},
            { image: "/third_part_logos/docker.png",  size: 20,  label: 'Docker'},
          ]}
          width={700}
          height={500}
          colorAccent="#7c6cfc"
          colorAccentHi="#b3aaff"
          colorLabel="#000"
          colorRing="rgba(255,255,255,0.45)"
          colorShadow="rgba(124,108,252,0.0)"
        />
        <small class="legal-advice">
          <br>
          The icons and trademarks shown on this portfolio belong to their respective owners and are used solely for identification purposes. Their presence does not imply affiliation, endorsement, or sponsorship.
        </small>
      </div>
    </ContainerHover>
  </section>

  <Division width_val={0} height_val={100} />

  <section>
    <h3 style="text-align: center;">Proyectos Principales</h2>
    <Division width_val={0} height_val={25} />
    <DevMainProjects />
  </section>

  <Division width_val={0} height_val={100} />

  <section>
    <h3 style="text-align: center;">Otros Proyectos</h3>
    <Division width_val={0} height_val={25} />
    <DevOtherProjects />
  </section>

  <div id="musica"></div>
  <Division width_val={0} height_val={100} />

  <section class="section-class">
    <Container
      border_radius = {20},
      padding_value = {30},
    >
      <TitleSection
        titulo="Producción Musical"
      >
        <p>Lo que inicia como un Hobbie desde 2017 hoy se ha convertido en una de mis fortalezas en la <strong>Multimedia.</strong> Cuento con experiencia en <strong>DAWs</strong> como <a href="https://www.image-line.com/">Fl Studio</a> y <a href="https://www.reaper.fm/">Reaper</a>, conocimientos en teoría músical y sobretodo una gran pasión por la música.</p>
      </TitleSection>
    </Container>
  </section>
  
  <Division width_val={0} height_val={50} />

  <section class="section-class">
    <MusicVideoPlayer />
  </section>

  <Division width_val={0} height_val={100} />

  <section id="animacion">
    <VideoFaderGallery
      videos={["crc3zlX2z3E", "KGOT1JO_v28", "fzZx6tQ_jLc"]}
      text="Animación 3D"
      subtext="Mi mayor sueño ha sido ser animador, darle vida a historias a travez del 3d es una de mis cosas favoritas."
    />
  </section>

  <Division width_val={0} height_val={100} />

  <section class="section-class">
    <Container border_radius={20} padding_value={30}>
      <TitleSection titulo="">
        <p>La animación 3D es una de mis pasiones más grandes. He trabajado con <strong>Blender</strong>, <strong>Maya</strong> y <strong>After Effects</strong> en proyectos que van desde modelado low-poly hasta animación de personajes. Mi objetivo es contar historias a través del arte digital, combinando técnicas tradicionales con tecnología moderna para crear piezas visuales únicas.</p>
      </TitleSection>
    </Container>
  </section>

  <Division width_val={0} height_val={100} />

  <section>
    <div class="aux-title-seemore">
      <h3 style="text-align: center;">Modelos 3D</h3>
      <SeeMore url='https://sketchfab.com/zergiopc'/>
    </div>
    <Division width_val={0} height_val={25} />
    <Models3DContainer />
  </section>
  <style>
    .aux-title-seemore {
      display: flex;
      flex-direction: row;
      justify-content: center;
      gap: 15px;
    }

    @media (max-width: 640px) {
      .aux-title-seemore {
        flex-direction: column;
        align-items: center;
      } 
    }
  </style>

  <div id="blog"></div>
  <Division width_val={0} height_val={100} />

  <section class="section-class">
    <Container border_radius={20} padding_value={30}>
      <div class="aux-title-seemore">
        <h2 style="text-align: center;">Blog</h2>
        <SeeMore url='/blog' />
      </div>
        
      <Division width_val={0} height_val={25} />
      <BlogPostsContainer posts={sortedPosts} />
    </Container>
  </section>

  <Footer />
</Layout>
