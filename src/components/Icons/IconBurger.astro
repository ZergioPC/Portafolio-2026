  width="100%"
  height="100%"
><g stroke-width="0"></g><g
    stroke-linecap="round"
    stroke-linejoin="round"></g><g>
    <path
      d="M5 12H20"
      stroke={color}
      stroke-width="2"
      stroke-linecap="round"
    ></path>
    <path
      d="M5 17H20"
      stroke={color}
      stroke-width="2"
      stroke-linecap="round"
    ></path>
    <path
      d="M5 7H20"
      stroke={color}
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </g></svg
>
