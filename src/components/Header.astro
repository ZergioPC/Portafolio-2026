---
interface Link {
  name: string;
  url: string;
}

interface Props {
  links?: Link[];
  id?: string;
}

const defaultLinks: Link[] = [
  { name: 'Inicio', url: '#inicio' },
  { name: 'Programación', url: '#programacion' },
  { name: 'Música', url: '#musica' },
  { name: 'Animación', url: '#animacion' },
  { name: 'Blog', url: '#blog' },
];

const { links = defaultLinks, id } = Astro.props;
import IconBurger from './Icons/IconBurger.astro';
---

<header id={id}>
  <nav>
    <button class="hamburger" aria-label="Abrir menú" aria-expanded="false">
      <IconBurger color="rgba(255,255,255,0.8)" />
    </button>
    <ul>
      {links.map((link) => (
        <li><a href={link.url}>{link.name}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector('header');
  const hamburger = header?.querySelector('.hamburger');
  const ul = header?.querySelector('ul');

  if (hamburger && ul) {
    hamburger.addEventListener('click', () => {
      const isOpen = header.classList.toggle('active');
      hamburger.setAttribute('aria-expanded', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    ul.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('active')) {
        header.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    });
  }
</script>

<style>
  header {
    z-index: 1000;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 0;
    background: transparent;
    background: linear-gradient(0deg, #ffffff00 0%, #000 80%);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  li a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 400;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.3s ease, border-bottom-color 0.3s ease, text-shadow 0.3s ease;
  }

  li a:hover {
    color: #fff;
    border-bottom-color: #b3aaff;
    text-shadow: 0 0 8px rgba(179, 170, 255, 0.6),
                 0 0 16px rgba(179, 170, 255, 0.3);
  }

  .hamburger {
    display: none;
  }

  @media (max-width: 640px) {
    header.active {
      background: rgba(0, 0, 0, 0.95);
    }

    nav {
      justify-content: flex-end;
    }

    .hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      width: 36px;
      height: 36px;
      z-index: 1100;
      color: rgba(255, 255, 255, 0.8);
    }

    ul {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    header.active ul {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    li a {
      font-size: 1.25rem;
    }
  }
</style>
