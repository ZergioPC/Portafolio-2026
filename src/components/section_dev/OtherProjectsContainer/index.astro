---
import "./styles.css";
import type { GithubRepo, GithubQueryParams} from "./types.d.ts";
import IconGithub from "@/components/Icons/IconGithub.astro";

// MARK:Obtener los Repos
const query:GithubQueryParams = {
  sort:"updated",
  direction: "desc",
  per_page: 12
}
const path_repos = `https://api.github.com/users/zergiopc/repos?sort=${query.sort}&direction=${query.direction}&per_page=${query.per_page}`
const repos_response: GithubRepo[] = await fetch(path_repos)
  .then(res => res.json())
  .then(data => data?.documentation_url ? [] : data)


function validarRepo(id:number): Boolean {
  const exluded_repos = [
    151878947, // fork de hyperblog (old curso platzi)
    722739392, // portafolio antiguo
  ]
  return !exluded_repos.includes(id)
}

const repos_result = repos_response.filter(repo => validarRepo(repo.id))

---



<!-- MARK: Componente -->
<div class="projects-container">
  {repos_result.map(repo => (
    <article>
      {repo.fork && <span>fork</span>}
      <div class="info">
        <h4>{repo.name.replace(/[-_]/g, " ")}</h4>
        <p>{repo.description.length >= 50 ? repo.description.slice(0,47)+"..." : repo.description}</p>
      </div>
      <div class="draws">
        <a href={repo.html_url} target="_blank" class="icon-rotate">
          <IconGithub size="100%" color="#fff" />
        </a>
        <ul data-langs={repo.languages_url} class="lang-container"/>
      </div>
    </article>
  ))}
</div>

<script>
  import "./script.ts"
</script>


<style>
  .projects-container{ 
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    justify-content: center;
    gap: 14px;
    margin: 0 auto;
    max-width: 1200px;
  }

  article span {
    position: absolute;
    top: -8px;
    right: -8px;
    transform: rotate(15deg);
    font-size: 0.65rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(0, 206, 201, 0.2);
    border: 1px solid rgba(0, 206, 201, 0.3);
    color: #00cec9;
    backdrop-filter: blur(4px);
  }

  article {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 48px;
    gap: 12px;
    padding: 20px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 350ms ease, border-color 350ms ease, box-shadow 350ms ease, background 350ms ease;
    cursor: default;
  }

  article h4 {
    font-size: 1.05rem;
    margin-bottom: 4px;
    transition: color 350ms ease;
  }

  article p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.4;
    transition: color 350ms ease;
  }

  article a {
    display: block;
    width: 100%;
  }

  @media (hover: hover) {
    article:hover {
      transform: translateY(-4px);
      border-color: rgba(0, 206, 201, 0.3);
      background: rgba(255, 255, 255, 0.06);
      box-shadow: 0 8px 32px rgba(0, 206, 201, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    article:hover h4 {
      color: #00cec9;
    }

    article:hover p {
      color: rgba(255, 255, 255, 0.75);
    }
  }

  @media (max-width: 1024px) {
    .projects-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-container {
      grid-template-columns: 1fr;
    }
  }
</style>