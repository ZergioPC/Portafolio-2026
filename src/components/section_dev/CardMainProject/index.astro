---
---
<article {...Astro.props}>
  <div>
    <div class="portada">
      <slot name="portada" />
    </div>
    <div class="content">
      <slot name="content" />
    </div>
  </div>
</article>

<style>
  /* Tarjeta */
  article {
    --size-value: clamp(280px, 80vw, 400px);

    height: var(--size-value);
    border-radius: 20px;
    transition: 300ms;
    overflow: hidden;
  }

  article > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100%;
    width: 100%;
  }

  article[card-state="default"] { width: var(--size-value);}
  article[card-state="open"] { width: calc(var(--size-value) * 2);}
  article[card-state="close"] { width: 0px;}

  /* Contenido */

  .portada, .content {
    aspect-ratio: 1/1;
    height: 100%;
    width: auto;
  }

  .portada {
    z-index: 2;
    cursor: pointer;
    background-color: #fff;
    overflow: hidden;
    transition: 300ms;
  }

  .content {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 15px;
    font-size: 1.5em;

    border: solid 1px #ffffff88;
    background-color: rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(5px);
    
    transition: 300ms;
  }

  @media (max-width: 768px) {
    article {
      --size-value: min(85vw, 320px);
      width: 100%;
      height: auto;
    }

    article > div {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    article[card-state="close"] {
      width: 0;
      height: 0;
      overflow: hidden;
      opacity: 0;
      margin: 0;
      padding: 0;
      pointer-events: none;
    }

    .content {
      font-size: 1em;
      padding: 12px;
      justify-content: flex-start;
      aspect-ratio: unset;
      height: auto;
      width: 100%;
    }

    .portada {
      aspect-ratio: 1/1;
      width: 100%;
      height: auto;
    }
  }
</style>