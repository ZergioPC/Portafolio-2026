---
export interface Props {
  words: string[];
  colors: string[];
  time: number;
}

const { words = [], colors = [], time = 2200 } = Astro.props;
---

<span class="word-switcher-wrap">
  <span id="word-switcher">{words[0]}</span></span>
</span>

<script is:inline define:vars={{ words, colors, time }}>
  const el = document.getElementById('word-switcher');
  const CHARS = ['.','|','🚀','💻','🛸','👾','#','⚙️','🧩','🎮'];
  
  let idx = 1;

  function glitchTo(target, color) {
    if (color) el.style.setProperty('--current-color', color);
    const maxFrames = 12;
    let frame = 0;
    const tick = () => {
      if (frame >= maxFrames) {
        el.textContent = target;
        return;
      }
      // All random until the very last frames
      const revealStart = Math.floor(maxFrames * 0.25);
      el.textContent = target
        .split('')
        .map((c, i) =>
          frame >= revealStart && i < (frame - revealStart) * (target.length / (maxFrames - revealStart))
            ? c
            : CHARS[Math.floor(Math.random() * CHARS.length)]
        )
        .join('');
      frame++;
      setTimeout(tick, 70);
    };
    tick();
  }

  if (el) {
    // Set initial color
    if (colors[0]) el.style.setProperty('--current-color', colors[0]);

    setInterval(() => {
      const color = colors.length > 0 ? colors[idx % colors.length] : null;
      glitchTo(words[idx], color);
      idx = idx >= words.length - 1 ? 0 : idx + 1;
    }, time);
  }
</script>

<style>
  .word-switcher-wrap {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    text-shadow: rgba(255, 255, 255, 0.3) 0 0 10px;
  }

  #word-switcher {
    padding: 5px 10px;
    font-family: "Zen Dots", sans-serif;
    font-size: 0.7em;
    color: var(--current-color, #1D9E75);
    transition: color 0.3s ease;
  }
</style>