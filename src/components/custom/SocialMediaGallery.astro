---
import socialData from "@/db/social.json"
import IconIg from "@/components/Icons/IconIg.astro"
import IconYt from "@/components/Icons/IconYt.astro"

interface SocialItem {
  platform: "youtube" | "instagram";
  url: string;
  handle: string;
  description: string;
  color: string;
}

const items: SocialItem[] = socialData

function hexToRgb(hex: string): string {
  const v = parseInt(hex.replace("#", ""), 16)
  return `${(v >> 16) & 255}, ${(v >> 8) & 255}, ${v & 255}`
}
---

<div class="social-grid">
  {items.map(item => {
    const Icon = item.platform === "youtube" ? IconYt : IconIg

    return (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="social-card"
        style={`--card-color: ${item.color}; --card-color-rgb: ${hexToRgb(item.color)}`}
      >
        <div class="card-icon">
          <Icon color={item.color} />
        </div>
        <span class="card-handle">{item.handle}</span>
        <p class="card-desc">{item.description}</p>
      </a>
    )
  })}
</div>

<style>
  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(220px, 25%, 320px), 1fr));
    gap: clamp(12px, 2vw, 24px);
    width: 100%;
  }

  .social-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 24px;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.04),
      rgba(var(--card-color-rgb), 0.08),
      rgba(255, 255, 255, 0.04)
    );
    background-size: 300% 300%;
    border: 1px solid rgba(var(--card-color-rgb), 0.2);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
    position: relative;
    overflow: hidden;
    animation: gradientShift 6s ease infinite;
  }

  .social-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--card-color-rgb), 0.12),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .social-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--card-color-rgb), 0.5);
    box-shadow:
      0 8px 32px rgba(var(--card-color-rgb), 0.15),
      0 0 0 1px rgba(var(--card-color-rgb), 0.1);
  }

  .social-card:hover::before {
    opacity: 1;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .card-icon {
    width: 48px;
    height: 48px;
  }

  .card-handle {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--card-color);
    text-shadow: 0 0 20px rgba(var(--card-color-rgb), 0.4);
    letter-spacing: 0.02em;
  }

  .social-card:hover .card-handle {
    text-shadow: 0 0 30px rgba(var(--card-color-rgb), 0.6);
  }

  .card-desc {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .social-grid {
      grid-template-columns: 1fr;
      padding: 0 10px;
    }
  }
</style>
