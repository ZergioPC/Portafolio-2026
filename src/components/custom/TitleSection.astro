---
const { titulo, desc } = Astro.props;
---

<div class="titleSection">
  <h2>{titulo}</h2>
  <div class="titleDesc">
    <slot />
  </div>
</div>

<style>
  .titleSection {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .titleDesc {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
  }
</style>