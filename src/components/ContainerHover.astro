---
interface Props {
  border_radius: number;
}

const { border_radius = 0 } = Astro.props
---

<div class="global-container">
  <slot />
</div>

<style define:vars={{ border_radius }}>
  .global-container {
    display: inline-block;

    /* Safe way to append 'px' to an Astro define:vars number */
    border-radius: calc(var(--border_radius) * 1px);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    
    /* Smooth transition for the hover effect */
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
    font-size: 0.7em;
    padding: var(--padding-1);
  }

  .global-container:hover {
    /* Brightens the top border slightly */
    border-top-color: rgba(255, 255, 255, 0.6); 
    
    /* Inset shadow shifted upward to create the inner top glow */
    box-shadow: inset 0 4px 8px -2px rgba(255, 255, 255, 0.4);
  }
</style>