---
interface Props {
  items: string[]
  radius?: string
}

const { items, radius = "0.5rem" } = Astro.props
---

<ul style={{ borderRadius: radius }}>
  {items.map(item => <li>{item}</li>)}
</ul>

<style>
  ul {
    list-style: none;
    padding: 0.75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(4px);
  }

  li {
    font-size: 0.8em;
    line-height: 1.5;
    color: #1a1a1a;
    padding: 5px 0.75rem;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 0.25rem;
  }
</style>
