---
import LogoAnim from "@/components/common/LogoAnim.astro";
import WordSwitcher from "@/components/common/WordSwitcher.astro";

import IconLinkedin from "@/components/Icons/IconLinkedin.astro";
import IconGithub from "@/components/Icons/IconGithub.astro";
import IconIg from "@/components/Icons/IconIg.astro";
---

<section>
    <div class="logo-wrapper">
      <LogoAnim size={300}/>
    </div>
    <div class="content">
      <h1 class="name">Sergio Palacios</h1>
      <div class="role">
        <WordSwitcher 
          words={["Programador","Músico","Videojuegos","Modelado 3D", "Animación", "Multimedia", "Audiovisuales"]}
          colors={["#1D9E75", "#7F77DD", "#D85A30"]}
          time={3500}
        />
      </div>
      <p class="description">Ingeniero multimedia, apasionado por el entretenimiento y contar buenas historias.</p>
      <ul class="social-links">
        <li>
          <a href="" class="social-icon" aria-label="LinkedIn">
            <IconLinkedin color="#ffffff" />
          </a>
        </li>
        <li>
          <a href="" class="social-icon" aria-label="GitHub">
            <IconGithub color="#ffffff" />
          </a>
        </li>
        <li>
          <a href="" class="social-icon" aria-label="Instagram">
            <IconIg color="#ffffff" />
          </a>
        </li>
      </ul>
    </div>
  </section>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem 1rem;
    text-align: center;
  }

  .logo-wrapper {
    margin: 0 auto;
    margin-bottom: 2rem;
  }

  .name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }

  .role {
    font-size: clamp(1.2rem, 3vw, 2rem);
    margin-bottom: 1.5rem;
  }

  .description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .social-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.25rem;
    justify-content: center;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background 0.3s, transform 0.3s, border-color 0.3s;
    padding: 12px;
  }

  .social-icon:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-3px);
  }

  .social-icon svg {
    width: 100%;
    height: 100%;
  }
</style>